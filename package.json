{
  "name": "bayanly",
  "version": "0.9.3-beta",
  "presentationExportVersion": "v0.4.2",
  "type": "module",
  "description": "An AI-powered platform for creating professional presentations in Arabic and English.",
  "scripts": {
    "test": "npm run test:template-converter && node --test scripts/package-metadata.test.mjs scripts/artifact-integrity.test.mjs scripts/product-metadata.test.mjs",
    "product:metadata": "node scripts/generate-product-metadata.mjs",
    "product:metadata:check": "node scripts/generate-product-metadata.mjs --check",
    "brand:scan": "node scripts/check-brand-consistency.mjs",
    "brand:release-check": "node scripts/check-brand-consistency.mjs --production",
    "localization:check": "node scripts/check-localization.mjs",
    "canonical:generate": "node scripts/generate-presentation-document.mjs",
    "canonical:check": "node scripts/generate-presentation-document.mjs --check",
    "canonical:fixtures": "node --test servers/nextjs/tests/presentation-document.test.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:architecture": "npm run check:boundaries",
    "convert:template": "node scripts/convert-template.mjs",
    "convert:presentation-template": "node scripts/convert-presentation-template.mjs",
    "test:template-converter": "node --test scripts/convert-template.test.mjs scripts/convert-presentation-template.test.mjs",
    "sync:presentation-export": "node scripts/sync-presentation-export.cjs",
    "sync:presentation-export:force": "node scripts/sync-presentation-export.cjs --force",
    "check:presentation-export": "node scripts/sync-presentation-export.cjs --check-only",
    "sbom:node": "node scripts/generate-sbom.mjs --node-only",
    "sbom:python": "node scripts/generate-sbom.mjs --python-only",
    "sbom": "node scripts/generate-sbom.mjs"
  },
  "dependencies": {
    "@llamaindex/liteparse": "2.10.1",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "6.0.0"
  }
}
